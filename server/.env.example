# ========================================================
# SkillConnect Server Production Environment Configuration
# ========================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# 1. Create a free cluster at https://cloud.mongodb.com/
# 2. Add a Database User (e.g. username: waris, password: yourSecurePassword123)
# 3. Network Access: Allow access from anywhere (0.0.0.0/0)
# 4. Click 'Connect' -> 'Drivers' -> Copy the connection string:
MONGO_URI=mongodb+srv://waris:yourSecurePassword123@cluster0.xxxx.mongodb.net/skillconnect?retryWrites=true&w=majority&appName=SkillConnectCluster

# Security Secret for JWT Authentication (32+ character random string)
JWT_SECRET=skillconnect_super_secret_jwt_token_key_2026_waris_production

# Frontend Client URL(s) for CORS validation (Comma-separated)
CLIENT_URL=https://skillconnect.com,https://www.skillconnect.com,http://localhost:5173

# Admin / Founder Details
ADMIN_EMAIL=amiflexboyc@gmail.com
ADMIN_WHATSAPP=09077108987
ADMIN_NAME=Waris (AmiFlexboy)

# Email SMTP Verification Service (e.g., Gmail, SendGrid, Mailgun, Brevo)
# Option 1: Gmail Service (Generate 16-character App Password in Google Account -> Security -> App Passwords)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-google-app-password
# EMAIL_FROM="SkillConnect" <your-email@gmail.com>

# Option 2: Custom SMTP Host
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
